Q1: Write a program in CUDA to add two vectors using
    a) block size as N
    b) N threads
    c) Varying block size to handle N elements with thread size constant as 256

#include <stdio.h>

// Kernel to add two vectors using block size as N
__global__ void addBlocks(float *res, float *v1, float *v2) {
    int i = blockIdx.x;
    res[i] = v1[i] + v2[i];     
}

// Kernel to add two vectors using N threads
__global__ void addThreads(float *res, float *v1, float *v2) {
    int i = threadIdx.x;
    res[i] = v1[i] + v2[i];     
}

// Kernel to add two vectors with varying block size
__global__ void addVarBlocks(float *res, float *v1, float *v2, int n) {
    int i = blockIdx.x * blockDim.x + threadIdx.x; 
    if (i < n) res[i] = v1[i] + v2[i];     
}

int main() {
    cudaMemcpyKind h2d = cudaMemcpyHostToDevice, d2h = cudaMemcpyDeviceToHost;
    int n;
    printf("Enter size: ");
    scanf("%d", &n);
    
    float v1[n], v2[n], res[n];
    float *d_v1, *d_v2, *d_res;

    cudaMalloc((void**)&d_v1, sizeof(float) * n);
    cudaMalloc((void**)&d_v2, sizeof(float) * n);
    cudaMalloc((void**)&d_res, sizeof(float) * n);

    printf("Enter v1: ");
    for (int i = 0; i < n; i++)
        scanf("%f", v1 + i);
    
    printf("Enter v2: ");
    for (int i = 0; i < n; i++)
        scanf("%f", v2 + i);

    // Copy input vectors to device
    cudaMemcpy(d_v1, v1, sizeof(float) * n, h2d);
    cudaMemcpy(d_v2, v2, sizeof(float) * n, h2d);
    
    // Perform vector addition using block size as N
    addBlocks<<<n, 1>>>(d_res, d_v1, d_v2);
    cudaMemcpy(res, d_res, n * sizeof(float), d2h);

    for (int i = 0; i < n; i++)
        printf("%f ", res[i]);
    printf("\n");

    // Perform vector addition using N threads
    addThreads<<<1, n>>>(d_res, d_v1, d_v2);
    cudaMemcpy(res, d_res, n * sizeof(float), d2h);
    
    for (int i = 0; i < n; i++)
        printf("%f ", res[i]);
    printf("\n");

    // Perform vector addition with varying block sizes
    addVarBlocks<<<ceil(n / 256.0), 256>>>(d_res, d_v1, d_v2, n);
    cudaMemcpy(res, d_res, n * sizeof(float), d2h);
    
    for (int i = 0; i < n; i++)
        printf("%f ", res[i]);
    printf("\n");
    
    cudaFree(d_v1);
    cudaFree(d_v2);
    cudaFree(d_res);

    return 0;
}

Q2: Write a program in CUDA which performs convolution operation on the input N elements
using a mask array with M elements to produce the resultant N elements.

#include <stdio.h>

// Kernel to perform convolution operation
__global__ void convKernel(int* input, int* mask, int* output, int n, int m) {
    int i = threadIdx.x;
    int j = threadIdx.y;
    // Calculate output only if within bounds
    if (m - 1 - j + i < n) 
        atomicAdd(output + (m - 1 - j + i), input[i] * mask[j]);
}

int main() {
    cudaMemcpyKind h2d = cudaMemcpyHostToDevice, d2h = cudaMemcpyDeviceToHost;

    int n, m;
    printf("Enter input size and mask size: ");
    scanf("%d %d", &n, &m);

    int input[n], mask[m], output[n];
    printf("Enter input array: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", input + i);
        output[i] = 0; // Initialize output array
    }

    printf("Enter mask array: ");
    for (int i = 0; i < m; i++)
        scanf("%d", mask + i);

    int *d_input, *d_mask, *d_output;

    cudaMalloc((void**)&d_input, sizeof(int) * n);
    cudaMalloc((void**)&d_mask, sizeof(int) * m);
    cudaMalloc((void**)&d_output, sizeof(int) * n);
    
    cudaMemcpy(d_input, input, sizeof(int) * n, h2d);
    cudaMemcpy(d_mask, mask, sizeof(int) * m, h2d);
    cudaMemcpy(d_output, output, sizeof(int) * n, h2d);
    
    dim3 threads(n, m, 1);
    convKernel<<<1, threads>>>(d_input, d_mask, d_output, n, m);

    cudaMemcpy(output, d_output, sizeof(int) * n, d2h);
    for (int i = 0; i < n; i++)
        printf("%d ", output[i]);
    printf("\n");

    cudaFree(d_input);
    cudaFree(d_mask);
    cudaFree(d_output);

    return 0;
}

Q3: Write a program in CUDA to perform linear algebra function of the form y = αx + y, where
x and y are vectors and α is a scalar value.

#include <stdio.h>

// Kernel to perform linear operation y = αx + y
__global__ void linTransform(int alpha, int* xVec, int* yVec) {
    int idx = threadIdx.x;
    yVec[idx] += alpha * xVec[idx]; // Update output vector
}

int main() {
    cudaMemcpyKind h2d = cudaMemcpyHostToDevice, d2h = cudaMemcpyDeviceToHost;

    printf("Enter vector size: ");
    int n; 
    scanf("%d", &n);

    int x[n], y[n], alpha, *d_x, *d_y;
    cudaMalloc((void**)&d_x, sizeof(int) * n);
    cudaMalloc((void**)&d_y, sizeof(int) * n);

    printf("Enter x vector: ");
    for (int i = 0; i < n; i++) 
        scanf("%d", x + i);
    cudaMemcpy(d_x, x, sizeof(int) * n, h2d);

    printf("Enter y vector: ");
    for (int i = 0; i < n; i++) 
        scanf("%d", y + i);
    cudaMemcpy(d_y, y, sizeof(int) * n, h2d);

    printf("Enter alpha: ");
    scanf("%d", &alpha);

    linTransform<<<1, n>>>(alpha, d_x, d_y);
    cudaMemcpy(y, d_y, sizeof(int) * n, d2h);

    for (int i = 0; i < n; i++)
        printf("%d ", y[i]);
    printf("\n");

    cudaFree(d_x);
    cudaFree(d_y);

    return 0;
}

Q4: Write a program in CUDA to process a 1D array containing angles in radians to generate
sine of the angles in the output array. Use appropriate function.

#include <stdio.h>
#include <math.h> // Include math header for sin function

// Kernel to compute sine of angles
__global__ void calcSine(float* angles, float* sines) {
    int idx = threadIdx.x;
    sines[idx] = sin(angles[idx]); // Calculate sine of angle
}

int main() {
    int n;
    printf("Enter number of angles: ");
    scanf("%d", &n);

    float angles[n], sines[n], *d_angles, *d_sines;
    cudaMalloc((void**)&d_angles, sizeof(float) * n);
    cudaMalloc((void**)&d_sines, sizeof(float) * n);

    printf("Enter angles in radians: ");
    for (int i = 0; i < n; i++) 
        scanf("%f", angles + i);
    cudaMemcpy(d_angles, angles, sizeof(float) * n, cudaMemcpyHostToDevice);

    calcSine<<<1, n>>>(d_angles, d_sines);
    cudaMemcpy(sines, d_sines, sizeof(float) * n, cudaMemcpyDeviceToHost);

    for (int i = 0; i < n; i++) 
        printf("%f ", sines[i]);
    printf("\n");

    cudaFree(d_angles);
    cudaFree(d_sines);

    return 0;
}

