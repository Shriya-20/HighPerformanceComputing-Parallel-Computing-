Q1: Write a program in CUDA to read MxN matrix. Replace 1st row of this matrix by same
    elements, 2nd row elements by square of each element and 3rd row elements by cube of each
    element and so on.

#include <stdio.h>

// Kernel to apply power transformation based on row index
__global__ void applyPower(int *mat, int n) {
    int row = threadIdx.x, col = threadIdx.y;
    int val = mat[n * row + col];
    for (int x = 0; x < row; x++) 
        mat[n * row + col] *= val; // Raise to the power of row index
}

int main() {
    int m, n;
    printf("Enter m, n: ");
    scanf("%d %d", &m, &n);

    int mat[m * n], *d_mat;
    printf("Enter matrix: ");
    for (int i = 0; i < m * n; i++) 
        scanf("%d", &mat[i]);

    cudaMalloc((void**)&d_mat, sizeof(int) * m * n);
    cudaMemcpy(d_mat, mat, sizeof(int) * m * n, cudaMemcpyHostToDevice);

    applyPower<<<1, dim3(m, n)>>>(d_mat, n);
    cudaMemcpy(mat, d_mat, sizeof(int) * m * n, cudaMemcpyDeviceToHost);

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++)
            printf("%d ", mat[n * i + j]);
        printf("\n");
    }

    return 0;
}

Q2: Write a program in CUDA to add two Matrices using
    a. Each row of resultant matrix to be computed by one thread.
    b. Each column of resultant matrix to be computed by one thread.
    c. Each element of resultant matrix to be computed by one thread.

#include <stdio.h>

// Kernel to add matrices row-wise
__global__ void addRows(int *a, int *b, int *c, int m, int n) {
    int row = threadIdx.x;
    for (int j = 0; j < n; j++) 
        c[n * row + j] = a[n * row + j] + b[n * row + j];
}

// Kernel to add matrices column-wise
__global__ void addCols(int *a, int *b, int *c, int m, int n) {
    int col = threadIdx.x;
    for (int i = 0; i < m; i++) 
        c[n * i + col] = a[n * i + col] + b[n * i + col];
}

// Kernel to add matrices element-wise
__global__ void addElems(int *a, int *b, int *c, int m, int n) {
    int row = threadIdx.x, col = threadIdx.y;
    c[n * row + col] = a[n * row + col] + b[n * row + col];
}

int main() {
    int m, n;
    printf("Enter m, n: ");
    scanf("%d %d", &m, &n);

    int a[m * n], b[m * n], c[m * n];
    printf("Enter matrix A: ");
    for (int i = 0; i < m * n; i++) scanf("%d", &a[i]);
    printf("Enter matrix B: ");
    for (int i = 0; i < m * n; i++) scanf("%d", &b[i]);

    int *d_a, *d_b, *d_c;
    cudaMalloc((void**)&d_a, sizeof(int) * m * n);
    cudaMalloc((void**)&d_b, sizeof(int) * m * n);
    cudaMalloc((void**)&d_c, sizeof(int) * m * n);

    cudaMemcpy(d_a, a, sizeof(int) * m * n, cudaMemcpyHostToDevice);
    cudaMemcpy(d_b, b, sizeof(int) * m * n, cudaMemcpyHostToDevice);

    addRows<<<1, m>>>(d_a, d_b, d_c, m, n);
    addCols<<<1, n>>>(d_a, d_b, d_c, m, n);
    addElems<<<1, dim3(m, n)>>>(d_a, d_b, d_c, m, n);
    cudaMemcpy(c, d_c, sizeof(int) * m * n, cudaMemcpyDeviceToHost);

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++)
            printf("%d ", c[n * i + j]);
        printf("\n");
    }

    return 0;
}

Q3: Repeat the above exercise for matrix multiplication.

#include <stdio.h>

// Kernel to multiply matrices row-wise
__global__ void multRows(int *a, int *b, int *c, int ma, int na, int nb) {
    int row = threadIdx.x;
    for (int j = 0; j < nb; j++) {
        c[na * row + j] = 0; // Initialize result
        for (int k = 0; k < na; k++)
            atomicAdd(c + na * row + j, a[na * row + k] * b[nb * k + j]); 
    }
}

// Kernel to multiply matrices column-wise
__global__ void multCols(int *a, int *b, int *c, int ma, int na, int nb) {
    int col = threadIdx.x;
    for (int i = 0; i < ma; i++) {
        c[na * i + col] = 0; // Initialize result
        for (int k = 0; k < na; k++)
            atomicAdd(c + na * i + col, a[na * i + k] * b[nb * k + col]); 
    }
}

// Kernel to multiply matrices element-wise
__global__ void multElems(int *a, int *b, int *c, int ma, int na, int nb) {
    int row = threadIdx.x, col = threadIdx.y;
    c[na * row + col] = 0; // Initialize result
    for (int k = 0; k < na; k++)
        atomicAdd(c + na * row + col, a[na * row + k] * b[nb * k + col]);
}

int main() {
    int ma, na, mb, nb;
    printf("Enter dimensions for matrix A (m, n): ");
    scanf("%d %d", &ma, &na);
    printf("Enter dimensions for matrix B (m, n): ");
    scanf("%d %d", &mb, &nb);

    if (na != mb) {
        printf("Matrix dimensions do not match for multiplication.\n");
        return -1;
    }

    int a[ma * na], b[mb * nb], c[ma * nb];
    printf("Enter matrix A: ");
    for (int i = 0; i < ma * na; i++) scanf("%d", &a[i]);
    printf("Enter matrix B: ");
    for (int i = 0; i < mb * nb; i++) scanf("%d", &b[i]);

    int *d_a, *d_b, *d_c;
    cudaMalloc((void**)&d_a, sizeof(int) * ma * na);
    cudaMalloc((void**)&d_b, sizeof(int) * mb * nb);
    cudaMalloc((void**)&d_c, sizeof(int) * ma * nb);

    cudaMemcpy(d_a, a, sizeof(int) * ma * na, cudaMemcpyHostToDevice);
    cudaMemcpy(d_b, b, sizeof(int) * mb * nb, cudaMemcpyHostToDevice);

    multRows<<<1, ma>>>(d_a, d_b, d_c, ma, na, nb);
    cudaMemcpy(c, d_c, sizeof(int) * ma * nb, cudaMemcpyDeviceToHost);
    for (int i = 0; i < ma; i++) {
        for (int j = 0; j < nb; j++)
            printf("%d ", c[nb * i + j]);
        printf("\n");
    }

    multCols<<<1, nb>>>(d_a, d_b, d_c, ma, na, nb);
    cudaMemcpy(c, d_c, sizeof(int) * ma * nb, cudaMemcpyDeviceToHost);
    for (int i = 0; i < ma; i++) {
        for (int j = 0; j < nb; j++)
            printf("%d ", c[nb * i + j]);
        printf("\n");
    }

    multElems<<<1, dim3(ma, nb)>>>(d_a, d_b, d_c, ma, na, nb);
    cudaMemcpy(c, d_c, sizeof(int) * ma * nb, cudaMemcpyDeviceToHost);
    for (int i = 0; i < ma; i++) {
        for (int j = 0; j < nb; j++)
            printf("%d ", c[nb * i + j]);
        printf("\n");
    }

    return 0;
}

