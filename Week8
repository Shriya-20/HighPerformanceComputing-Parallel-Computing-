Q3: Write a program in CUDA to count the number of times a given word is repeated in a
sentence. (Use Atomic function)

#include <stdio.h>

// Kernel to count occurrences of a substring
__global__ void countWords(char* text, char* word, int* count, int words[], int wordLen) {
    int idx = threadIdx.x;
    if (words[idx + 1] - 1 - words[idx] != wordLen) return;
    for (int x = 0; x < wordLen; x++)
        if (text[words[idx] + x] != word[x]) return; // Check for match
    atomicAdd(count, 1); // Increment count if match found
}

int main() {
    int n;
    printf("Number of words: ");
    scanf("%d", &n);

    int words[n + 1], *d_words; 
    words[0] = 0; 
    char str[100], sub[100], *d_str, *d_sub;

    printf("Enter string: ");
    getchar(); // Consume newline
    fgets(str, 100, stdin);

    int count = 1;
    for (int i = 0; str[i] != '\0'; i++)
        if (str[i] == ' ') words[count++] = i + 1; // Store word positions
    words[count] = i; // Store end position

    printf("Enter substring: ");
    fgets(sub, 100, stdin);
    int subLen = 0; 
    for (; sub[subLen] != '\0'; subLen++); 
    subLen--; // Exclude null terminator

    int *d_count;
    cudaMalloc((void**)&d_str, sizeof(char) * words[count]);
    cudaMalloc((void**)&d_sub, sizeof(char) * subLen);
    cudaMalloc((void**)&d_words, (count + 1) * sizeof(int));
    cudaMalloc(&d_count, sizeof(int));

    cudaMemcpy(d_str, str, sizeof(char) * words[count], cudaMemcpyHostToDevice);
    cudaMemcpy(d_sub, sub, sizeof(char) * subLen, cudaMemcpyHostToDevice);
    cudaMemcpy(d_words, words, sizeof(int) * (count + 1), cudaMemcpyHostToDevice);
    cudaMemcpy(d_count, &count, sizeof(int), cudaMemcpyHostToDevice);

    countWords<<<1, count>>>(d_str, d_sub, d_count, d_words, subLen);
    cudaMemcpy(&count, d_count, sizeof(int), cudaMemcpyDeviceToHost);
    printf("%d\n", count);

    return 0;
}

