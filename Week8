Q4: Write a CUDA program that reads a string with N words and reverse entire string in
parallel.

#include <stdio.h>

// Kernel to reverse entire string
__global__ void reverseString(char* input, char* output, int length) {
    int idx = threadIdx.x;
    output[idx] = input[length - 1 - idx]; // Reverse the string
}

int main() {
    int length; 
    char str[100], *d_str, *d_rev;

    printf("Enter string: ");
    fgets(str, 100, stdin);
    for (length = 0; str[length] != '\0'; length++); 
    length--; // Exclude null terminator

    cudaMalloc((void**)&d_str, sizeof(char) * length);
    cudaMalloc((void**)&d_rev, sizeof(char) * length);

    cudaMemcpy(d_str, str, sizeof(char) * length, cudaMemcpyHostToDevice);
    reverseString<<<1, length>>>(d_str, d_rev, length);
    cudaMemcpy(str, d_rev, sizeof(char) * length, cudaMemcpyDeviceToHost);

    puts(str);

    return 0;
}

