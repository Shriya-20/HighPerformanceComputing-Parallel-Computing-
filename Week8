Q1: Write a CUDA program that takes a string S as input and one integer value N. Produces
    output string N times as follows in parallel:
    I/p: S = Hello
    N=3
    O/p String: HelloHelloHello (Each thread copies entire S)

#include <stdio.h>

// Kernel to duplicate string S N times
__global__ void stringMult(char* src, char* dest, int size) {
    int idx = threadIdx.x;
    dest[idx] = src[idx % size]; // Copy characters in a circular manner
}

int main() {
    cudaMemcpyKind h2d = cudaMemcpyHostToDevice,
                   d2h = cudaMemcpyDeviceToHost;

    printf("Enter n: ");
    int n; scanf("%d", &n);

    printf("Enter string size: ");
    int size; scanf("%d", &size);

    char str[size], result[n * size], *d_str, *d_result;
    cudaMalloc((void**)&d_str, sizeof(char) * size);
    cudaMalloc((void**)&d_result, sizeof(char) * size * n);
    
    printf("Enter string: ");
    for (int i = 0; i < size; i++) scanf(" %c", str + i);
    cudaMemcpy(d_str, str, sizeof(char) * size, h2d);

    stringMult<<<1, n * size>>>(d_str, d_result, size);
    cudaMemcpy(result, d_result, sizeof(char) * n * size, d2h);

    for (int i = 0; i < n * size; i++) 
        printf("%c", result[i]);
    printf("\n");

    return 0;
}

Q2: Write a CUDA program which reads a string consisting of N words and reverse each
word of it in parallel.

#include <stdio.h>

// Kernel to reverse each word in the string
__global__ void reverseWords(char* input, char* output, int words[]) {
    int idx = threadIdx.x;
    for (int x = words[idx]; x < words[idx + 1] - 1; x++)
        output[x] = input[words[idx + 1] - 2 - x + words[idx]];
    output[words[idx + 1] - 1] = ' '; // Add space after each reversed word
}

int main() {
    int n;
    printf("Number of words: ");
    scanf("%d", &n);

    int words[n + 1], *d_words; 
    words[0] = 0; // Initialize first word position
    char str[100], *d_str, *d_rev;

    printf("Enter string: ");
    getchar(); // Consume newline from previous input
    fgets(str, 100, stdin); // Read input string

    int count = 1;
    for (int i = 0; str[i] != '\0'; i++)
        if (str[i] == ' ') words[count++] = i + 1; // Store word start positions
    words[count] = i; // Store end position

    cudaMalloc((void**)&d_rev, sizeof(char) * words[count]);
    cudaMalloc((void**)&d_str, sizeof(char) * words[count]);
    cudaMalloc((void**)&d_words, (count + 1) * sizeof(int));

    cudaMemcpy(d_str, str, sizeof(char) * words[count], cudaMemcpyHostToDevice);
    cudaMemcpy(d_words, words, sizeof(int) * (count + 1), cudaMemcpyHostToDevice);

    reverseWords<<<1, count>>>(d_str, d_rev, d_words);
    cudaMemcpy(str, d_rev, sizeof(char) * words[count], cudaMemcpyDeviceToHost);

    puts(str);
    return 0;
}
